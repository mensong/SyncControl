<Window x:Class="SyncControl.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SyncControl.GUI.Views"
        xmlns:viewModels="clr-namespace:SyncControl.GUI.ViewModels"
        Title="SyncControl"
        Width="1120"
        Height="720"
        MinWidth="860"
        MinHeight="580"
        Background="#F1F5F9"
        Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,10">
                <Button DockPanel.Dock="Right" Content="保存" MinWidth="88" Padding="10,4"
                        FontWeight="SemiBold"
                        Command="{Binding SaveAllCommand}"
                        ToolTip="保存所有配置、布局和自启动设置；服务运行中会同时推送到 Core" />
                <StackPanel Orientation="Horizontal">
                <RadioButton Content="主控端" GroupName="CoreRole" VerticalAlignment="Center"
                             Margin="0,0,12,0"
                             IsChecked="{Binding IsMasterRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <RadioButton Content="被控端" GroupName="CoreRole" VerticalAlignment="Center"
                             IsChecked="{Binding IsSlaveRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Border Width="1" Margin="14,2" Background="#CBD5E1" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="#334155" />
                <Border Width="1" Margin="14,2" Background="#CBD5E1" />
                <TextBlock Text="{Binding ClipboardStatusText}" VerticalAlignment="Center" Foreground="#64748B" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#FEE2E2" BorderBrush="#FCA5A5"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsServiceError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel Margin="12,8">
                <Button DockPanel.Dock="Right" Content="重启服务" MinWidth="88" Padding="10,4"
                        Command="{Binding RestartServiceCommand}" />
                <TextBlock Text="C++ 服务连接中断。" VerticalAlignment="Center" Foreground="#991B1B" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,8">
                <ProgressBar DockPanel.Dock="Right" Width="220" Height="6" VerticalAlignment="Center"
                             Minimum="0" Maximum="100"
                             Value="{Binding TransferProgressPercent, Mode=OneWay}"
                             Visibility="{Binding IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding TransferProgressText}" VerticalAlignment="Center"
                           Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FocusText}" Foreground="#334155" FontWeight="SemiBold" />
                    <Border Width="1" Margin="12,2" Background="#CBD5E1" />
                    <TextBlock Text="{Binding ConnectionSummaryText}" Foreground="#64748B" />
                    <Border Width="1" Margin="12,2" Background="#CBD5E1" />
                    <TextBlock Text="{Binding PeerLatencyText}" Foreground="#64748B"
                               MaxWidth="300" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="通用配置">
                <StackPanel Margin="24,20" MaxWidth="520" HorizontalAlignment="Left">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="连接密钥" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SecurityKey, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" />
                    </Grid>
                    <TextBlock Text="留空表示无密钥模式" Foreground="#64748B" FontSize="12" Margin="0,0,0,12" />
                    <CheckBox Content="自动启动" IsChecked="{Binding AutostartEnabled}"
                              Checked="Autostart_Checked" Unchecked="Autostart_Unchecked"
                              Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding ToggleServiceText, Mode=OneWay}" MinWidth="112" Padding="10,6"
                                Command="{Binding ToggleServiceCommand}" />
                    </StackPanel>

                    <Separator Margin="0,24,0,0" Background="#E2E8F0" />
                    <TextBlock Text="剪贴板同步" FontSize="16" FontWeight="SemiBold"
                               Foreground="#0F172A" Margin="0,16,0,0" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="确认阈值(MB)" VerticalAlignment="Center"
                                   ToolTip="文件/HTML/富文本超过该大小时才弹框确认，0 表示总是确认" />
                        <TextBox Grid.Column="1" Text="{Binding ClipboardConfirmThresholdMb}"
                                 Padding="6,4" />
                    </Grid>
                    <Button Content="应用剪贴板设置"
                            HorizontalAlignment="Left"
                            MinWidth="112"
                            Margin="0,16,0,0"
                            Padding="10,6"
                            Command="{Binding ApplyClipboardConfirmThresholdCommand}" />

                    <Separator Margin="0,24,0,0" Background="#E2E8F0" />
                    <TextBlock Text="运行状态"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding NetworkStatusText}"
                               Margin="0,10,0,4"
                               Foreground="#334155"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MouseLossText}" Foreground="#64748B" />

                    <Separator Margin="0,24,0,0" Background="#E2E8F0" />
                    <TextBlock Text="危险操作"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#B91C1C" Margin="0,16,0,0" />
                    <Button Content="清除配置"
                            HorizontalAlignment="Left"
                            MinWidth="112"
                            Margin="0,16,0,0"
                            Padding="10,6"
                            BorderBrush="#FCA5A5"
                            Command="{Binding ClearConfigCommand}"
                            ToolTip="清除所有配置、数据、自启动计划和 Helper 服务，需要重启程序" />
                </StackPanel>
            </TabItem>
            <TabItem Header="主控端配置" IsEnabled="{Binding MasterTabEnabled}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10">
                        <TextBlock Text="绑定 IP" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding BindIp, UpdateSourceTrigger=PropertyChanged}"
                                 Width="140" Padding="6,4" />
                        <TextBlock Text="端口" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" Padding="6,4" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" MaxWidth="520" HorizontalAlignment="Left"
                                Margin="12,0,12,0">
                        <TextBlock Text="边缘切换策略" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#0F172A" Margin="0,10,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="切换模式" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedValue="{Binding SwitchMode}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="碰边立即切换" Tag="immediate" />
                                <ComboBoxItem Content="连续碰撞切换" Tag="bump" />
                                <ComboBoxItem Content="边缘停留切换" Tag="dwell" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,0"
                              Visibility="{Binding IsBumpMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="碰撞窗口(ms)" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding BumpWindowMs}" Padding="6,4" />
                            <TextBlock Grid.Column="2" Text="碰撞次数" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" Text="{Binding BumpCount}" Padding="6,4" />
                        </Grid>
                        <Grid Margin="0,10,0,0"
                              Visibility="{Binding IsDwellMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="停留时间(ms)" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding DwellMs}" Padding="6,4" />
                        </Grid>
                        <Button Content="应用切换策略"
                                HorizontalAlignment="Left"
                                MinWidth="112"
                                Margin="0,16,0,12"
                                Padding="10,6"
                                Command="{Binding ApplySwitchPolicyCommand}" />
                    </StackPanel>
                    <local:LayoutCanvas />
                </DockPanel>
            </TabItem>
            <TabItem Header="被控端配置" IsEnabled="{Binding SlaveTabEnabled}">
                <StackPanel Margin="24,20" MaxWidth="520" HorizontalAlignment="Left">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主控端 IP" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding MasterIp, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主控端端口" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding MasterPort, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="本机端口" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SlavePort, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" />
                    </Grid>
                    <TextBlock Text="{Binding MasterStatusText}" Foreground="#334155" FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

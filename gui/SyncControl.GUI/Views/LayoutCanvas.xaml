<UserControl x:Class="SyncControl.GUI.Views.LayoutCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SyncControl.GUI.Models">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Canvas x:Name="CanvasHost" Background="#F8FAFC"
                MouseWheel="CanvasHost_MouseWheel"
                PreviewMouseRightButtonDown="CanvasHost_PreviewMouseRightButtonDown"
                MouseMove="CanvasHost_MouseMove"
                MouseRightButtonUp="CanvasHost_MouseRightButtonUp">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CanvasScale" />
                    <TranslateTransform x:Name="CanvasTranslate" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <ItemsControl ItemsSource="{Binding Highlights}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsHitTestVisible="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Brush}"
                                   RadiusX="2" RadiusY="2" Opacity="0.9" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Screens}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ScreenNode}">
                        <Border Width="{Binding Width}" Height="{Binding Height}"
                                Background="#FFFFFF" BorderBrush="{Binding StatusBrush}"
                                BorderThickness="2" CornerRadius="4"
                                MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                MouseMove="Node_MouseMove"
                                MouseLeftButtonUp="Node_MouseLeftButtonUp">
                            <Border.Tag>
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </Border.Tag>
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="编辑属性"
                                              Command="{Binding EditNodeCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="删除"
                                              Command="{Binding DeleteNodeCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Margin="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                    <Ellipse Grid.Column="1" Width="10" Height="10"
                                             VerticalAlignment="Center" Margin="6,0,0,0"
                                             Fill="{Binding StatusBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding Id}" FontSize="12" Foreground="#64748B"
                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Ip}" FontSize="12" Foreground="#475569"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="#475569" Margin="0,3,0,0">
                                    <Run Text="{Binding ScreenW, Mode=OneWay}" />
                                    <Run Text="x" />
                                    <Run Text="{Binding ScreenH, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#0F766E" Margin="0,3,0,0"
                                           Text="{Binding LatencyText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
        <Button Content="重置视图"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,12,0"
                Padding="10,4"
                MinWidth="72"
                Click="ResetViewButton_Click" />
    </Grid>
</UserControl>
